PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/art

JWT_SECRET=replace-with-a-long-secret
JWT_EXPIRY=30d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="ART <no-reply@art.local>"

CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─────────────────────────────────────────────────────────────────────────────
# AWS CORE
# ─────────────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-iam-access-key
AWS_SECRET_ACCESS_KEY=your-iam-secret-key

# ─────────────────────────────────────────────────────────────────────────────
# S3
# ─────────────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=art-videos-private

# ─────────────────────────────────────────────────────────────────────────────
# MEDIACONVERT
# Get endpoint: aws mediaconvert describe-endpoints
# ─────────────────────────────────────────────────────────────────────────────
MEDIACONVERT_ENDPOINT=https://xxxxxxxx.mediaconvert.ap-south-1.amazonaws.com
MEDIACONVERT_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT:role/art-mediaconvert-role
MEDIACONVERT_QUEUE_ARN=arn:aws:mediaconvert:ap-south-1:YOUR_ACCOUNT:queues/Default

# ─────────────────────────────────────────────────────────────────────────────
# CLOUDFRONT
# CLOUDFRONT_PRIVATE_KEY — paste the RSA PEM with \n (literal backslash-n)
# e.g. -----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----
# ─────────────────────────────────────────────────────────────────────────────
CLOUDFRONT_DOMAIN=your-distribution-id.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=APKA...
CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----"

# ─────────────────────────────────────────────────────────────────────────────
# RAZORPAY (use test keys during development)
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-secret

# ─────────────────────────────────────────────────────────────────────────────
# SNS — MediaConvert job notifications
# ─────────────────────────────────────────────────────────────────────────────
SNS_MEDIACONVERT_TOPIC_ARN=arn:aws:sns:ap-south-1:YOUR_ACCOUNT:art-mediaconvert-jobs
SNS_WEBHOOK_SECRET=random-secret-for-extra-header-validation

# ─────────────────────────────────────────────────────────────────────────────
# DRM — set DRM_PROVIDER=none to use clear HLS (current default)
# Options: none | pallycon | axinom | ezdrm
# ─────────────────────────────────────────────────────────────────────────────
DRM_PROVIDER=none
DRM_SPEKE_URL=
DRM_SPEKE_TOKEN=
DRM_WIDEVINE_LICENSE_URL=
DRM_FAIRPLAY_LICENSE_URL=
DRM_PLAYREADY_LICENSE_URL=
